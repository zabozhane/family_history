# Family Media System — template only. Copy to `.env` and replace every placeholder.
#
# Quick bootstrap with random secrets (run from repo root):
#   cp .env.example .env
#   python3 - <<'PY'
#   import secrets, pathlib
#   p = pathlib.Path(".env")
#   t = p.read_text()
#   t = t.replace("REPLACE_WITH_OPENSSL_RAND_BASE64_48", secrets.token_urlsafe(48))
#   t = t.replace("REPLACE_WITH_OPENSSL_RAND_HEX_24", secrets.token_hex(24))
#   t = t.replace("REPLACE_WITH_OPENSSL_RAND_HEX_10", secrets.token_hex(10))
#   t = t.replace("REPLACE_WITH_OPENSSL_RAND_HEX_32", secrets.token_hex(32))
#   p.write_text(t)
#   PY
#
# If you change POSTGRES_* after Postgres was already initialized, wipe the DB volume:
#   docker compose down -v && docker compose up -d

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_48
API_JWT_ALGORITHM=HS256
API_JWT_ACCESS_TTL_SECONDS=900
API_JWT_REFRESH_TTL_SECONDS=2592000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=family_media
POSTGRES_USER=family
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO (S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_10
S3_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
S3_BUCKET=family-media
S3_REGION=us-east-1
S3_USE_SSL=false

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
